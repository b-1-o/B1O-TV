{
  "name": "b1o-tv",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/optimize-tv-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "dev:assistant": "wrangler dev --config worker/wrangler.toml --remote",
    "deploy:assistant": "wrangler deploy --config worker/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck:assistant": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "deploy:tizen": "bash scripts/deploy-tizen-tv.sh"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "wrangler": "^4.40.0",
    "vitest": "^2.1.8"
  },
  "description": "Remote-first monochrome media dashboard for Samsung Tizen TVs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b-1-o/B1web.git"
  },
  "homepage": "https://github.com/b-1-o/B1web#readme",
  "bugs": {
    "url": "https://github.com/b-1-o/B1web/issues"
  },
  "keywords": [
    "samsung-smart-tv",
    "tizen",
    "smart-tv",
    "media-dashboard",
    "jellyfin",
    "selfmusic",
    "self-hosted",
    "react",
    "typescript",
    "remote-control",
    "cloudflare-workers"
  ]
}
